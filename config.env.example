# =========================================================================
# BlogHero - Configuration
# You normally never need to edit this by hand - the app's setup wizard
# writes it for you. This file exists mainly for reference/manual editing.
# Never commit config.env (with real keys) to a public place.
# =========================================================================

# --- Site being analyzed / written for ---
SITE_DOMAIN=sierralivingconcepts.com
SITE_BASE_URL=https://www.sierralivingconcepts.com

# --- Google Search Console (via the official, free Google API) ---
# GSC_SITE_URL must match EXACTLY how the property is registered in Search
# Console - the app's setup wizard connects and shows you a picker list of
# the exact strings your service account can see.
# Typically either "https://www.sierralivingconcepts.com/" (URL-prefix
# property, note trailing slash) or "sc-domain:sierralivingconcepts.com"
# (domain property).
GSC_SITE_URL=https://www.sierralivingconcepts.com/
# Uses the SAME service account JSON as the Google Sheets logger below -
# one credential, two scopes (Sheets + Search Console readonly).
# IMPORTANT one-time manual step Google requires (see README.md):
# add the service account's email as a User in Search Console > Settings >
# Users and permissions, or every call will 403.

# --- Gemini API (free tier - text + image generation) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Verify current model names in Google's docs before running - these change over time.
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- WordPress (drafts only - tool never auto-publishes) ---
# Create an "Application Password" under WP Admin > Users > Profile > Application Passwords
# (NOT your real login password)
WP_SITE_URL=https://www.sierralivingconcepts.com
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- Google Sheets (run log, for human review) ---
# 1. Create a Google Cloud service account, enable "Google Sheets API"
# 2. Download the JSON key, save it as data/gsheets_service_account.json
# 3. Create a Google Sheet, share it with the service account's email (as Editor)
# 4. Paste the Sheet ID below (the long string in the sheet's URL)
GSHEETS_SERVICE_ACCOUNT_FILE=data/gsheets_service_account.json
GSHEETS_SHEET_ID=your_google_sheet_id_here
GSHEETS_LOG_TAB=Run Log

# --- Run behavior ---
MAX_TOPICS_PER_RUN=2
MIN_WORD_COUNT=1200
MAX_WORD_COUNT=1500
REVIVAL_IMPRESSION_THRESHOLD=5000
GAP_IMPRESSION_THRESHOLD=500
